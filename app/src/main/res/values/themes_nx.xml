<?xml version="1.0" encoding="utf-8"?>
<!-- Sistema de diseño Nexus para las pantallas que no son de vuelo. -->
<resources>

    <style name="Theme.Nexus.App" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/nx_accent</item>
        <item name="colorPrimaryVariant">@color/nx_accent_deep</item>
        <item name="colorOnPrimary">@color/nx_fg</item>
        <item name="colorSecondary">@color/nx_telemetry</item>
        <item name="colorOnSecondary">@color/nx_background</item>
        <item name="colorSurface">@color/nx_surface</item>
        <item name="colorOnSurface">@color/nx_fg</item>
        <item name="colorError">@color/nx_critical</item>
        <item name="android:colorBackground">@color/nx_background</item>
        <item name="android:windowBackground">@color/nx_background</item>
        <item name="android:textColorPrimary">@color/nx_fg</item>
        <item name="android:textColorSecondary">@color/nx_fg_muted</item>
        <item name="android:textColorHint">@color/nx_fg_muted</item>
        <item name="colorControlNormal">@color/nx_fg_muted</item>
        <item name="colorControlActivated">@color/nx_accent</item>
        <item name="android:statusBarColor">@color/nx_background</item>
        <item name="android:navigationBarColor">@color/nx_background</item>
        <item name="android:windowLightStatusBar">@bool/nx_light_system_bars</item>
        <item name="android:listDivider">@drawable/nx_divider</item>
        <item name="alertDialogTheme">@style/Theme.Nexus.Dialog</item>
        <item name="materialAlertDialogTheme">@style/Theme.Nexus.Dialog</item>
        <item name="android:alertDialogTheme">@style/Theme.Nexus.Dialog</item>
        <item name="android:spinnerDropDownItemStyle">@style/Nx.SpinnerDropDownItem</item>
    </style>

    <style name="Theme.Nexus.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">@color/nx_accent</item>
        <item name="colorSurface">@color/nx_surface</item>
        <item name="colorOnSurface">@color/nx_fg</item>
        <item name="android:windowBackground">@drawable/bg_nx_dialog</item>
        <item name="android:textColorPrimary">@color/nx_fg</item>
        <item name="android:textColorSecondary">@color/nx_fg_muted</item>
        <item name="android:textColorAlertDialogListItem">@color/nx_fg</item>
        <item name="colorControlNormal">@color/nx_fg_muted</item>
        <item name="colorControlActivated">@color/nx_accent</item>
        <item name="buttonBarPositiveButtonStyle">@style/Nx.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Nx.DialogButton.Muted</item>
        <item name="buttonBarNeutralButtonStyle">@style/Nx.DialogButton.Muted</item>
    </style>

    <!-- Diálogo a pantalla completa sin marco (login, job One Stop) -->
    <style name="Theme.Nexus.Dialog.Bare" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="colorPrimary">@color/nx_accent</item>
        <item name="colorControlActivated">@color/nx_accent</item>
        <item name="colorControlNormal">@color/nx_fg_muted</item>
        <item name="android:textColorPrimary">@color/nx_fg</item>
        <item name="android:textColorHint">@color/nx_fg_muted</item>
    </style>

    <!-- Diálogo a pantalla completa (datos de turbina One Stop) -->
    <style name="Theme.Nexus.Dialog.Fullscreen" parent="Theme.Nexus.App">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@color/nx_background</item>
    </style>

    <style name="Nx.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/nx_telemetry</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="Nx.DialogButton.Muted">
        <item name="android:textColor">@color/nx_fg_muted</item>
    </style>

    <!-- Raíces vacías: los estilos Nx.* heredan por nombre -->
    <style name="Nx" />
    <style name="Nx.Value" />

    <!-- Estructura -->
    <style name="Nx.TopBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/nx_topbar_h</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/nx_space_l</item>
        <item name="android:paddingEnd">@dimen/nx_space_l</item>
        <item name="android:background">@drawable/bg_nx_topbar</item>
    </style>

    <style name="Nx.TopBar.Title">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/nx_fg</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Nx.Wordmark">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:text">NEXUS</item>
        <item name="android:textColor">@color/nx_fg</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.42</item>
    </style>

    <style name="Nx.Card">
        <item name="android:background">@drawable/bg_nx_card</item>
        <item name="android:padding">@dimen/nx_space_m</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Nx.SectionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/nx_accent_muted</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <style name="Nx.Body">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/nx_fg</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Nx.Body.Muted">
        <item name="android:textColor">@color/nx_fg_muted</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Nx.Value.Mono">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/nx_telemetry</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Controles -->
    <style name="Nx.Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/nx_control_h</item>
        <item name="android:background">@drawable/bg_nx_field</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textColor">@color/nx_fg</item>
        <item name="android:textColorHint">@color/nx_fg_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableTint">@color/nx_fg_muted</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Nx.Spinner">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/nx_control_h</item>
        <item name="android:background">@drawable/bg_nx_spinner</item>
        <item name="android:popupBackground">@color/nx_surface_raised</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">30dp</item>
    </style>

    <style name="Nx.SpinnerDropDownItem" parent="Widget.AppCompat.DropDownItem.Spinner">
        <item name="android:textColor">@color/nx_fg</item>
    </style>

    <style name="Nx.Button.Primary" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_height">@dimen/nx_control_h</item>
        <item name="android:minHeight">@dimen/nx_control_h</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/nx_btn_primary_bg</item>
        <item name="android:textColor">@color/nx_btn_primary_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="cornerRadius">@dimen/nx_radius_s</item>
        <item name="iconTint">@color/nx_on_accent</item>
        <item name="iconSize">16dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="Nx.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_height">@dimen/nx_control_h</item>
        <item name="android:minHeight">@dimen/nx_control_h</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">@color/nx_border_strong</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/nx_btn_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/nx_radius_s</item>
        <item name="rippleColor">@color/nx_accent_tint</item>
        <item name="iconTint">@color/nx_fg_muted</item>
        <item name="iconSize">16dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">6dp</item>
    </style>

    <style name="Nx.Button.Danger" parent="Nx.Button.Secondary">
        <item name="strokeColor">@color/nx_critical</item>
        <item name="android:textColor">@color/nx_critical</item>
        <item name="backgroundTint">@color/nx_critical_tint</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="iconTint">@color/nx_critical</item>
    </style>

    <!-- Botón pequeño con contorno azul (SET) -->
    <style name="Nx.Button.Mini" parent="Nx.Button.Secondary">
        <item name="android:layout_height">32dp</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="strokeColor">@color/nx_accent</item>
        <item name="android:textColor">@color/nx_telemetry</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <!-- Botón cuadrado de icono (volver, ajustes, actualizar) -->
    <style name="Nx.IconButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:minWidth">36dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="strokeColor">@color/nx_border_subtle</item>
        <item name="cornerRadius">@dimen/nx_radius_s</item>
        <item name="iconTint">@color/nx_fg_muted</item>
        <item name="iconSize">18dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="rippleColor">@color/nx_accent_tint</item>
    </style>

    <style name="Nx.Segment">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/nx_segment_text</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Nx.Pill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:background">@drawable/bg_nx_pill</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textColor">@color/nx_fg_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:drawablePadding">6dp</item>
    </style>
</resources>
