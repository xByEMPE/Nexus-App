<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- FPV (Fondo) -->
    <dji.v5.ux.core.widget.fpv.FPVWidget
        android:id="@+id/widget_onestop_fpv"
        android:layout_width="match_parent"
        android:layout_height="match_parent" >

        <dji.v5.ux.core.widget.hsi.PrimaryFlightDisplayWidget
            android:id="@+id/widget_pfd"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:layout_editor_absoluteX="0dp"
            tools:layout_editor_absoluteY="0dp" />
    </dji.v5.ux.core.widget.fpv.FPVWidget>

    <!-- Mira de apuntado (Foto ID y medición), centrada en el vídeo -->
    <mx.com.nexusio.fly.drone.onestop.CrosshairView
        android:id="@+id/view_onestop_crosshair"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/widget_onestop_fpv"
        app:layout_constraintBottom_toBottomOf="@id/widget_onestop_fpv"
        app:layout_constraintStart_toStartOf="@id/widget_onestop_fpv"
        app:layout_constraintEnd_toEndOf="@id/widget_onestop_fpv" />

    <!-- PFD (Centro/HUD) -->

    <!-- Brújula/Mapa HSI (Esquina Inferior Izquierda) -->
    <dji.v5.ux.core.widget.hsi.HorizontalSituationIndicatorWidget
        android:id="@+id/widget_hsi"
        android:layout_width="wrap_content"
        android:layout_height="160dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="-30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Top Bar DJI (Batería, Señal, Satélites) -->
    <dji.v5.ux.core.panel.topbar.TopBarPanelWidget
        android:id="@+id/panel_top_bar"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:background="#000000"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        app:uxsdk_itemsMarginRight="16dp"
        app:uxsdk_itemsSpacing="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Barra de batería / tiempo de vuelo restante (DJI) -->
    <dji.v5.ux.core.widget.remainingflighttime.RemainingFlightTimeWidget
        android:id="@+id/widget_remaining_flight_time"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_marginTop="-8dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/panel_top_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Barra de Progreso One-Stop y Telemetría LRF -->
    <LinearLayout
        android:id="@+id/workflow_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/widget_remaining_flight_time"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Pasos de medición One-Stop (orden de captura) -->
        <TextView android:id="@+id/step_hub" android:layout_width="35dp" android:layout_height="35dp" android:background="@drawable/circle_bg" android:gravity="center" android:text="@string/onestop_step_hub" android:textColor="#FFF" android:textSize="11sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" ➔ " android:textColor="#FFF" android:textStyle="bold"/>
        <TextView android:id="@+id/step_tip12" android:layout_width="35dp" android:layout_height="35dp" android:background="@drawable/circle_bg" android:gravity="center" android:text="@string/onestop_step_tip12" android:textColor="#FFF" android:textSize="11sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" ➔ " android:textColor="#FFF" android:textStyle="bold"/>
        <TextView android:id="@+id/step_bottom12" android:layout_width="35dp" android:layout_height="35dp" android:background="@drawable/circle_bg" android:gravity="center" android:text="@string/onestop_step_bottom12" android:textColor="#FFF" android:textSize="11sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" ➔ " android:textColor="#FFF" android:textStyle="bold"/>
        <TextView android:id="@+id/step_tip4" android:layout_width="35dp" android:layout_height="35dp" android:background="@drawable/circle_bg" android:gravity="center" android:text="@string/onestop_step_tip4" android:textColor="#FFF" android:textSize="11sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" ➔ " android:textColor="#FFF" android:textStyle="bold"/>
        <TextView android:id="@+id/step_tip8" android:layout_width="35dp" android:layout_height="35dp" android:background="@drawable/circle_bg" android:gravity="center" android:text="@string/onestop_step_tip8" android:textColor="#FFF" android:textSize="11sp" android:textStyle="bold"/>

        <!-- Estado de la Fase -->
        <TextView
            android:id="@+id/tv_onestop_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/onestop_status_ready"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="#99000000"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:layout_marginHorizontal="16dp"/>

        <!-- Distancia LRF -->
        <TextView
            android:id="@+id/tv_onestop_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onestop_distance_none"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:background="#FFFFFF"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp" />
    </LinearLayout>

    <!-- Panel de información: violaciones de objetivo, resumen del plan, progreso -->
    <TextView
        android:id="@+id/tv_onestop_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="6dp"
        android:background="#99000000"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:textColor="#FFEB3B"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/workflow_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Master Controls (Esquina Derecha) -->
    <LinearLayout
        android:id="@+id/layout_master_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/plan_view_frame"
        android:layout_marginEnd="16dp">

        <!-- Fijar el punto de casa en la posición actual del dron -->
        <android.widget.Button
            android:id="@+id/btn_onestop_home"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="@drawable/home_point_bg"
            android:contentDescription="@string/onestop_home_set_title"
            android:padding="0dp"
            android:text="H"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <ImageButton
            android:id="@+id/btn_onestop_pause"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="@drawable/circle_bg_gray"
            android:src="@android:drawable/ic_media_pause"
            android:contentDescription="@string/onestop_pause"
            android:layout_marginBottom="12dp"
            android:visibility="gone"/>

        <!-- Botón de Play/Stop de la Misión Automática -->
        <ImageButton
            android:id="@+id/btn_onestop_action"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/circle_bg_solid"
            android:backgroundTint="#4CAF50"
            android:src="@android:drawable/ic_media_play"
            app:tint="#FFFFFF"
            android:scaleType="centerInside"
            android:padding="14dp"
            android:elevation="6dp" />

        <LinearLayout
            android:id="@+id/layout_brightness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="16dp">

            <android.widget.Button
                android:id="@+id/btn_ev_plus"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:text="+"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/circle_bg_gray"
                android:layout_marginBottom="8dp"/>

            <android.widget.Button
                android:id="@+id/btn_ev_minus"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:text="-"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/circle_bg_gray" />
        </LinearLayout>
    </LinearLayout>

    <!-- Visor 3D del plan: miniatura abajo a la derecha; al tocarla se amplía y "Volver a la cámara" la cierra -->
    <FrameLayout
        android:id="@+id/plan_view_frame"
        android:layout_width="210dp"
        android:layout_height="130dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:elevation="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <mx.com.nexusio.fly.drone.onestop.planview.PlanView3D
            android:id="@+id/plan_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/onestop_plan_hint" />

        <TextView
            android:id="@+id/plan_view_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="6dp"
            android:background="#B3000000"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="@string/onestop_plan_hint"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/plan_view_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button android:id="@+id/btn_plan_front" style="?android:attr/buttonBarButtonStyle" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="0dp" android:paddingHorizontal="10dp" android:text="@string/onestop_plan_front" android:textColor="#FFFFFF" android:background="#B3151A22" android:layout_marginEnd="6dp" />
            <Button android:id="@+id/btn_plan_side" style="?android:attr/buttonBarButtonStyle" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="0dp" android:paddingHorizontal="10dp" android:text="@string/onestop_plan_side" android:textColor="#FFFFFF" android:background="#B3151A22" android:layout_marginEnd="6dp" />
            <Button android:id="@+id/btn_plan_top" style="?android:attr/buttonBarButtonStyle" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="0dp" android:paddingHorizontal="10dp" android:text="@string/onestop_plan_top" android:textColor="#FFFFFF" android:background="#B3151A22" android:layout_marginEnd="6dp" />
            <Button android:id="@+id/btn_plan_iso" style="?android:attr/buttonBarButtonStyle" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="0dp" android:paddingHorizontal="10dp" android:text="@string/onestop_plan_iso" android:textColor="#FFFFFF" android:background="#B3151A22" android:layout_marginEnd="12dp" />
            <Button android:id="@+id/btn_plan_back" android:layout_width="wrap_content" android:layout_height="44dp" android:paddingHorizontal="14dp" android:text="@string/onestop_plan_back" android:textColor="#FFFFFF" android:textStyle="bold" android:backgroundTint="#4CAF50" />
        </LinearLayout>
    </FrameLayout>

    <!-- Paro de emergencia: visible mientras se sube y se vuela la misión; por encima de todo (también del visor 3D) -->
    <Button
        android:id="@+id/btn_onestop_emergency"
        android:layout_width="wrap_content"
        android:layout_height="72dp"
        android:minWidth="140dp"
        android:layout_marginStart="16dp"
        android:paddingHorizontal="18dp"
        android:backgroundTint="#D32F2F"
        android:text="@string/onestop_emergency_button"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:elevation="16dp"
        android:stateListAnimator="@null"
        android:contentDescription="@string/onestop_emergency_button"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>