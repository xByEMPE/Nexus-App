<?xml version="1.0" encoding="utf-8"?>
<!-- Perfil de piloto: sesión a la izquierda, historial de turbinas a la derecha. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nx_background"
    android:orientation="vertical">

    <LinearLayout style="@style/Nx.TopBar">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back_to_main"
            style="@style/Nx.IconButton"
            android:contentDescription="Volver"
            app:icon="@drawable/ic_nx_back" />

        <TextView
            style="@style/Nx.TopBar.Title"
            android:layout_width="0dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Perfil de piloto" />

        <TextView style="@style/Nx.Wordmark" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="@dimen/nx_space_m">

        <!-- ============ SESIÓN ============ -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9"
            android:background="@drawable/bg_nx_card"
            android:fillViewport="true">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/nx_space_m">

                <!-- Sin sesión -->
                <LinearLayout
                    android:id="@+id/layout_login_form"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Nx.Body"
                        android:text="Iniciar sesión"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Nx.Body.Muted"
                        android:layout_marginTop="2dp"
                        android:text="Accede con tu cuenta de piloto para sincronizar proyectos." />

                    <TextView
                        style="@style/Nx.SectionLabel"
                        android:layout_marginTop="14dp"
                        android:text="Correo electrónico" />

                    <EditText
                        android:id="@+id/et_pilot_email"
                        style="@style/Nx.Field"
                        android:autofillHints="emailAddress"
                        android:drawableStart="@drawable/ic_nx_mail"
                        android:hint="piloto@empresa.com"
                        android:inputType="textEmailAddress" />

                    <TextView
                        style="@style/Nx.SectionLabel"
                        android:layout_marginTop="10dp"
                        android:text="Contraseña" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundMode="none"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/nx_fg_muted"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_pilot_password"
                            style="@style/Nx.Field"
                            android:autofillHints="password"
                            android:drawableStart="@drawable/ic_nx_lock"
                            android:hint="Contraseña"
                            android:inputType="textPassword"
                            android:paddingEnd="44dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_pilot_login"
                        style="@style/Nx.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_marginTop="16dp"
                        android:text="INICIAR SESIÓN" />
                </LinearLayout>

                <!-- Con sesión -->
                <LinearLayout
                    android:id="@+id/layout_pilot_profile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_nx_avatar"
                            android:contentDescription="Piloto"
                            android:padding="10dp"
                            android:src="@drawable/ic_nx_user"
                            app:tint="@color/nx_telemetry" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_logged_pilot_name"
                                style="@style/Nx.Body"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="Nombre"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_logged_pilot_license"
                                style="@style/Nx.Body.Muted"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="Licencia"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_nx_field"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <TextView
                                style="@style/Nx.SectionLabel"
                                android:layout_marginBottom="2dp"
                                android:text="Horas totales" />

                            <TextView
                                android:id="@+id/tv_current_flight_hours"
                                style="@style/Nx.Value.Mono"
                                android:text="0.0"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_nx_field"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <TextView
                                style="@style/Nx.SectionLabel"
                                android:layout_marginBottom="2dp"
                                android:text="Turbinas · proyecto" />

                            <TextView
                                android:id="@+id/tv_inspected_count"
                                style="@style/Nx.Value.Mono"
                                android:text="0"
                                android:textColor="@color/nx_fg"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_pending_hours"
                        style="@style/Nx.Body.Muted"
                        android:layout_marginTop="6dp"
                        android:text="Sin sincronizar: 0.0 h"
                        android:textColor="@color/nx_caution"
                        android:textSize="11sp"
                        android:visibility="gone" />

                    <TextView
                        style="@style/Nx.SectionLabel"
                        android:layout_marginTop="12dp"
                        android:text="Registrar horas de vuelo" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/et_add_flight_hours"
                            style="@style/Nx.Field"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:hint="+ 0.0 h"
                            android:importantForAutofill="no"
                            android:inputType="numberDecimal" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_add_hours"
                            style="@style/Nx.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Añadir"
                            app:icon="@drawable/ic_nx_plus" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_pilot_logout"
                        style="@style/Nx.Button.Danger"
                        android:layout_width="match_parent"
                        android:layout_marginTop="16dp"
                        android:text="CERRAR SESIÓN"
                        app:icon="@drawable/ic_nx_logout" />
                </LinearLayout>
            </FrameLayout>
        </ScrollView>

        <!-- ============ HISTORIAL ============ -->
        <LinearLayout
            style="@style/Nx.Card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/nx_space_m"
            android:layout_weight="1.4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Nx.SectionLabel"
                    android:layout_width="0dp"
                    android:layout_marginBottom="0dp"
                    android:layout_weight="1"
                    android:text="Historial de turbinas inspeccionadas" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sync_history"
                    style="@style/Nx.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minHeight="32dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Actualizar"
                    android:textSize="11sp"
                    app:icon="@drawable/ic_nx_refresh"
                    app:iconSize="14dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:layout_marginTop="8dp"
                android:background="@color/nx_surface_raised"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <TextView
                    style="@style/Nx.SectionLabel"
                    android:layout_width="0dp"
                    android:layout_marginBottom="0dp"
                    android:layout_weight="1"
                    android:text="Turbina"
                    android:textColor="@color/nx_fg_muted" />

                <TextView
                    style="@style/Nx.SectionLabel"
                    android:layout_width="0dp"
                    android:layout_marginBottom="0dp"
                    android:layout_weight="1"
                    android:text="Estado"
                    android:textColor="@color/nx_fg_muted" />

                <TextView
                    style="@style/Nx.SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_marginBottom="0dp"
                    android:minWidth="90dp"
                    android:gravity="end"
                    android:text="Fecha"
                    android:textColor="@color/nx_fg_muted" />
            </LinearLayout>

            <ListView
                android:id="@+id/lv_inspection_history"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@color/nx_border_subtle"
                android:dividerHeight="1dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
