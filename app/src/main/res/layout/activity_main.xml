<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla principal del dron (opción A): barra superior + Proyecto · Inspección · Aeronave -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nx_background"
    android:orientation="vertical">

    <!-- Barra superior -->
    <LinearLayout style="@style/Nx.TopBar">

        <TextView style="@style/Nx.Wordmark" />

        <View
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@color/nx_border_strong" />

        <TextView
            style="@style/Nx.Body.Muted"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Inspecciones Industriales" />

        <TextView
            android:id="@+id/tv_drone_status"
            style="@style/Nx.Pill"
            android:layout_marginStart="8dp"
            android:drawableStart="@drawable/bg_nx_dot"
            android:drawableTint="@color/nx_caution"
            android:text="Dron no conectado" />

        <!-- Modo día / noche (por defecto noche) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_theme_mode"
            style="@style/Nx.IconButton"
            android:layout_marginStart="8dp"
            android:contentDescription="Cambiar a modo día"
            app:icon="@drawable/ic_nx_sun" />

        <!-- Píldora del piloto: abre el perfil (con sesión) o el inicio de sesión (sin sesión) -->
        <TextView
            android:id="@+id/tv_config_title"
            style="@style/Nx.Pill"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_nx_pill"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:drawableStart="@drawable/ic_nx_user_sm"
            android:drawableTint="@color/nx_fg_muted"
            android:maxWidth="180dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Iniciar sesión" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_aircraft_settings"
            style="@style/Nx.IconButton"
            android:layout_marginStart="8dp"
            android:contentDescription="Ajustes de aeronave"
            app:icon="@drawable/ic_nx_settings" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="@dimen/nx_space_m">

            <!-- ============ PROYECTO ============ -->
            <LinearLayout
                style="@style/Nx.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <TextView
                    style="@style/Nx.SectionLabel"
                    android:text="Proyecto" />

                <Spinner
                    android:id="@+id/spinner_project"
                    style="@style/Nx.Spinner"
                    android:layout_height="40dp" />

                <TextView
                    android:id="@+id/tv_project_client"
                    style="@style/Nx.Body.Muted"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Cliente: -"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_project_farm"
                    style="@style/Nx.Body.Muted"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Parque: -"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Nx.SectionLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginBottom="0dp"
                        android:text="Turbinas pendientes" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_sync_turbines"
                        style="@style/Nx.IconButton"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:minWidth="30dp"
                        android:minHeight="30dp"
                        android:contentDescription="Actualizar proyectos"
                        app:icon="@drawable/ic_nx_refresh"
                        app:iconSize="16dp"
                        app:iconTint="@color/nx_telemetry" />
                </LinearLayout>

                <ListView
                    android:id="@+id/lv_pending_turbines"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_nx_list"
                    android:divider="@color/nx_border_subtle"
                    android:dividerHeight="1dp"
                    android:padding="1dp"
                    android:scrollbarThumbVertical="@color/nx_border_strong" />
            </LinearLayout>

            <!-- ============ INSPECCIÓN ============ -->
            <LinearLayout
                style="@style/Nx.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/nx_space_m"
                android:layout_weight="1.4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <RadioGroup
                        android:id="@+id/rg_inspection_type"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rb_single_stop"
                            style="@style/Nx.Segment"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_nx_segment_left"
                            android:text="One Stop" />

                        <RadioButton
                            android:id="@+id/rb_three_stop"
                            style="@style/Nx.Segment"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_nx_segment_right"
                            android:text="Three Stop" />
                    </RadioGroup>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_reset_inspection"
                        style="@style/Nx.IconButton"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:minWidth="34dp"
                        android:minHeight="34dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="Reiniciar registro de palas"
                        app:icon="@drawable/ic_nx_reset"
                        app:iconSize="16dp" />
                </LinearLayout>

                <!-- Three Stop: pala a inspeccionar -->
                <LinearLayout
                    android:id="@+id/layout_three_stop_params"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Nx.Body.Muted"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Pala a inspeccionar" />

                    <Spinner
                        android:id="@+id/spinner_blade"
                        style="@style/Nx.Spinner"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1.2" />
                </LinearLayout>

                <!-- Largo de pala: One Stop y Three Stop -->
                <LinearLayout
                    android:id="@+id/layout_blade_length"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Nx.Body.Muted"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Largo de pala (m)" />

                    <EditText
                        android:id="@+id/et_blade_length"
                        style="@style/Nx.Field"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1.2"
                        android:fontFamily="monospace"
                        android:hint="Ej: 34.5"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal" />
                </LinearLayout>

                <!-- One Stop: datos de turbina (job + altura de buje) -->
                <LinearLayout
                    android:id="@+id/layout_one_stop_job"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_nx_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="4dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tv_job_summary"
                        style="@style/Nx.Value.Mono"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/onestop_job_summary_pending"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_job_configure"
                        style="@style/Nx.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:minHeight="32dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/onestop_job_configure"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- One Stop: orientación de palas sobre la foto de la turbina -->
                <LinearLayout
                    android:id="@+id/layout_one_stop_rotor_selector"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <mx.com.nexusio.fly.drone.onestop.RotorOrientationView
                        android:id="@+id/rotor_orientation_view"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ AERONAVE ============ -->
            <LinearLayout
                style="@style/Nx.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/nx_space_m"
                android:layout_weight="0.8">

                <TextView
                    style="@style/Nx.SectionLabel"
                    android:text="Aeronave" />

                <ImageView
                    android:id="@+id/iv_drone"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:contentDescription="Dron"
                    android:scaleType="fitCenter"
                    android:src="@drawable/drone" />

                <TextView
                    style="@style/Nx.Body.Muted"
                    android:layout_marginTop="8dp"
                    android:text="Modo de palancas"
                    android:textSize="11sp" />

                <Spinner
                    android:id="@+id/spinner_rc_mode"
                    style="@style/Nx.Spinner"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_flight"
                    style="@style/Nx.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_marginTop="10dp"
                    android:enabled="false"
                    android:text="CONTINUAR" />

                <TextView
                    android:id="@+id/tv_app_version"
                    style="@style/Nx.Body.Muted"
                    android:layout_width="match_parent"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="v1.0"
                    android:textSize="10sp" />
            </LinearLayout>
    </LinearLayout>
</LinearLayout>
