<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema de arranque: fondo negro y sin icono, para que el paso al splash de Compose sea invisible. -->
    <style name="Theme.Nexus.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="postSplashScreenTheme">@style/Theme.Nexus</item>
    </style>

    <!-- Tema normal de la app (si ya tienes uno, solo asegúrate de que el fondo sea negro al inicio). -->
    <style name="Theme.Nexus" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

</resources>
